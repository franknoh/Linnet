// A small decoder-only transformer built entirely from standard-library
// operations. Nothing here is specific to one model family; a checkpoint
// binds the parameters listed by `linnet inspect --parameters`.
module tiny_transformer

use std.nn.attention::{attention, causal_mask}
use std.nn.embedding::{Embedding}
use std.nn.linear::{Linear}
use std.nn.mlp::{SwiGlu}
use std.nn.norm::{RmsNorm}
use std.nn.rope::{rope}

pub block Attention<H: Dim, Heads: Dim, T: Float>
where
    H % Heads == 0,
    Heads > 0,
    (H / Heads) % 2 == 0
{
    sub q_proj: Linear<H, H, T>
    sub k_proj: Linear<H, H, T>
    sub v_proj: Linear<H, H, T>
    sub o_proj: Linear<H, H, T>

    pub fn forward<B: Dim, S: Dim>(
        x: Tensor[B, S, H; T],
        cos_table: Tensor[S, H / Heads; T],
        sin_table: Tensor[S, H / Heads; T],
    ) -> Tensor[B, S, H; T] {
        let q = split_heads<B, S, H, Heads, T>(q_proj.forward(x))
        let k = split_heads<B, S, H, Heads, T>(k_proj.forward(x))
        let v = split_heads<B, S, H, Heads, T>(v_proj.forward(x))
        let mixed = attention(
            rope(q, cos_table, sin_table),
            rope(k, cos_table, sin_table),
            v,
            0.125,
            some(causal_mask<S, S>()),
        )
        return o_proj.forward(merge_heads<B, S, H, Heads, T>(mixed))
    }
}

fn split_heads<B: Dim, S: Dim, H: Dim, Heads: Dim, T: Float>(
    x: Tensor[B, S, H; T],
) -> Tensor[B, Heads, S, H / Heads; T]
where
    H % Heads == 0,
    Heads > 0,
    (H / Heads) % 2 == 0
{
    return permute(reshape(x, [B, S, Heads, H / Heads]), [0, 2, 1, 3])
}

fn merge_heads<B: Dim, S: Dim, H: Dim, Heads: Dim, T: Float>(
    x: Tensor[B, Heads, S, H / Heads; T],
) -> Tensor[B, S, H; T]
where
    H % Heads == 0,
    Heads > 0,
    (H / Heads) % 2 == 0
{
    return reshape(permute(x, [0, 2, 1, 3]), [B, S, H])
}

pub block DecoderLayer<H: Dim, Heads: Dim, Inner: Dim, T: Float>
where
    H % Heads == 0,
    Heads > 0,
    (H / Heads) % 2 == 0
{
    sub attention_norm: RmsNorm<H, T>
    sub attention: Attention<H, Heads, T>
    sub mlp_norm: RmsNorm<H, T>
    sub mlp: SwiGlu<H, Inner, T>

    pub fn forward<B: Dim, S: Dim>(
        x: Tensor[B, S, H; T],
        cos_table: Tensor[S, H / Heads; T],
        sin_table: Tensor[S, H / Heads; T],
    ) -> Tensor[B, S, H; T] {
        let attended = x + attention.forward(attention_norm.forward(x), cos_table, sin_table)
        return attended + mlp.forward(mlp_norm.forward(attended))
    }
}

pub block Model<Vocab: Dim, H: Dim, Heads: Dim, Inner: Dim, Layers: Dim, T: Float = bf16>
where
    H % Heads == 0,
    Heads > 0,
    (H / Heads) % 2 == 0
{
    sub embedding: Embedding<Vocab, H, T>
    sub layers: [DecoderLayer<H, Heads, Inner, T>; Layers]
    sub norm: RmsNorm<H, T>
    sub head: Linear<H, Vocab, T>

    pub entry forward<B: Dim, S: Dim>(
        tokens: Tensor[B, S; i32],
        cos_table: Tensor[S, H / Heads; T],
        sin_table: Tensor[S, H / Heads; T],
    ) -> Tensor[B, S, Vocab; T] {
        var x = embedding.forward(tokens)
        static for layer in layers {
            x = layer.forward(x, cos_table, sin_table)
        }
        return head.forward(norm.forward(x))
    }
}
