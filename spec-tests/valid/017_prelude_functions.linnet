module tests.prelude

pub fn relu<*S: Shape, T: Float>(x: Tensor[*S; T]) -> Tensor[*S; T] {
    return max(x, 0.0)
}

pub fn flatten<B: Dim, S: Dim, H: Dim, T: Numeric>(x: Tensor[B, S, H; T]) -> Tensor[B * S, H; T] {
    return reshape(x, [B * S, H])
}

pub fn swap_last<B: Dim, S: Dim, H: Dim>(x: Tensor[B, S, H; f32]) -> Tensor[B, H, S; f32] {
    return permute(x, [0, 2, 1])
}

pub fn causal_mask<S: Dim>() -> Tensor[S, S; bool] {
    let position = iota(S)
    let mask[q, k] = position[q] >= position[k]
    return mask
}

pub fn masked<S: Dim>(score: Tensor[S, S; f32]) -> Tensor[S, S; f32] {
    return select(causal_mask<S>(), score, fill<f32>([S, S], -1e9))
}

pub fn join<*S: Shape, A: Dim, B: Dim, T: Float>(
    a: Tensor[*S, A; T],
    b: Tensor[*S, B; T],
) -> Tensor[*S, A + B; T] {
    return concat(a, b, axis = -1)
}

pub fn widen<H: Dim>(x: Tensor[H; bf16]) -> Tensor[H; f32] {
    return cast<f32>(x) * cast<f32>(H)
}
