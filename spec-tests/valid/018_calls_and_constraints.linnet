module tests.calls

pub fn split_heads<B: Dim, S: Dim, H: Dim, N: Dim, T: Float>(
    x: Tensor[B, S, H; T],
) -> Tensor[B, N, S, H / N; T]
where
    H % N == 0,
    N > 0
{
    return permute(reshape(x, [B, S, N, H / N]), [0, 2, 1, 3])
}

pub fn scale<*S: Shape, T: Float>(x: Tensor[*S; T], factor: T, bias: T = 0.0) -> Tensor[*S; T] {
    return x * factor + bias
}

pub fn heads<B: Dim, S: Dim, D: Dim>(x: Tensor[B, S, 8 * D; bf16]) -> Tensor[B, 8, S, D; bf16] {
    let scaled = scale(x, bias = 1.0, factor = 0.5)
    return split_heads<B, S, 8 * D, 8>(scaled)
}
