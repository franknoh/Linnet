module tests.functions

// An entry at module level has no `self`: a function of its inputs alone.
pub entry mean_squared_error<B: Dim, N: Dim>(
    predicted: Tensor[B, N; f32],
    target: Tensor[B, N; f32],
) -> f32 {
    let error[b, n] = predicted[b, n] - target[b, n]
    return sum[b, n] error[b, n] * error[b, n] / cast<f32>(B * N)
}

// A block's entry calls it like any function.
pub block Regressor<In: Dim, Out: Dim> {
    param weight: Tensor[Out, In; f32]

    pub entry loss<B: Dim>(x: Tensor[B, In; f32], target: Tensor[B, Out; f32]) -> f32 {
        let y[b, o] = sum[i] x[b, i] * weight[o, i]
        return mean_squared_error(y, target)
    }
}
