module m

dtype nibble = int(bits: 4, signed: false)
dtype levels = codebook(carrier: nibble, values: [
    -8.0,
    -4.0,
    -2.0,
    -1.5,
    -1,
    -0.75,
    -0.5,
    -0.25,
    0,
    0.25,
    0.5,
    1,
    2,
    4,
    6,
    8,
])

// Codes are not numbers to add: cast to a computing dtype first.
fn twice(x: Tensor[8; levels]) -> Tensor[8; levels] {
    return x + x
}
