// Element formats beyond the built-in ones. Each is a storage format: a
// tensor of one is cast to and from, moved, sliced and gathered, and cast
// to a computing dtype (`bf16`, `f32`) to compute with (spec §3.1).
module std.dtypes

// FP8 E4M3 with no infinities and one NaN (`float8_e4m3fn`): range ±448.
pub dtype f8e4m3 = float(exponent: 4, mantissa: 3, inf: false)

// FP8 E5M2, IEEE-like with infinities and NaNs: range ±57344.
pub dtype f8e5m2 = float(exponent: 5, mantissa: 2)

// Four-bit formats, stored two elements a byte along a tensor's last axis:
// element 2k in the low four bits, 2k + 1 in the high four. The last axis
// has an even length, and an operation keeps it whole (spec §3.1).

// Two's complement integers: -8 to 7, and 0 to 15.
pub dtype i4 = int(bits: 4)
pub dtype u4 = int(bits: 4, signed: false)

// FP4 E2M1 (OCP MX), with neither infinities nor NaN: 0, 0.5, 1, 1.5, 2, 3,
// 4, 6 and their negatives.
pub dtype f4e2m1 = float(exponent: 2, mantissa: 1, inf: false, nan: false)

// NF4 (QLoRA's NormalFloat): codes of `u4` for 16 values spread as a normal
// distribution's quantiles over -1 to 1, the ones bitsandbytes uses. A cast
// to it takes each value to the nearest of them (a tie to the lower).
pub dtype nf4 = codebook(carrier: u4, values: [
    -1.0,
    -0.6961928009986877,
    -0.5250730514526367,
    -0.39491748809814453,
    -0.28444138169288635,
    -0.18477343022823334,
    -0.09105003625154495,
    0.0,
    0.07958029955625534,
    0.16093020141124725,
    0.2461123019456863,
    0.33791524171829224,
    0.44070982933044434,
    0.5626170039176941,
    0.7229568362236023,
    1.0,
])
