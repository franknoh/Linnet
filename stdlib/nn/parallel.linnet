module std.nn.parallel

// The sum of `x` over the shards of a model split across devices (tensor
// parallelism): each device holds part of a sum -- a projection back out of
// the heads or the hidden units it computed, from the input rows it holds --
// and every device needs the whole of it. With one shard, a model on one
// device, the sum is `x` itself, which is the body; a backend that runs the
// shards as processes adds them across devices.
pub op all_reduce<*S: Shape, T: Float>(x: Tensor[*S; T]) -> Tensor[*S; T] {
    return x
}

// The shards' parts of `x` side by side along its last axis: each device of
// a model split across devices holds a slice of an output -- the logits of
// its part of a vocabulary -- and every device needs the whole, the shards in
// order. With one shard the result is `x` itself. The body repeats `x` once
// per shard, which is that for one shard and the right shape for any; a
// backend that runs the shards as processes gathers their parts instead.
pub op all_gather<R: Dim, N: Dim, Shards: Dim, T: Float>(
    x: Tensor[R, N; T],
) -> Tensor[R, Shards * N; T]
where Shards > 0 {
    return reshape(broadcast_to(reshape(x, [R, 1, N]), [R, Shards, N]), [R, Shards * N])
}

// `x` as every shard reads it: the input of a split computation (the
// projections into the heads or the hidden units, an output head split by
// vocabulary), whole on each device of a model split across devices. The
// value is `x`. In training, each shard's gradient of it comes from its own
// part of the weights; a backend that runs the shards as processes sums
// those parts, as `all_reduce` sums the forward pass's. With one shard, `x`
// itself.
pub op shared<*S: Shape, T: Float>(x: Tensor[*S; T]) -> Tensor[*S; T] {
    return x
}
