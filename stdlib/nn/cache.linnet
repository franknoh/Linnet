module std.nn.cache

// One position of a key/value cache.
//
// The canonical body is a select over every position, which is what a
// backend without a scatter has to do; a backend that can write one slice
// (`index_copy`, `dynamic_update_slice`) writes only `at`. Decoding calls
// this once per layer per token, so the difference is the whole step.
pub op write_at<B: Dim, H: Dim, S: Dim, D: Dim, T: Float>(
    cache: Tensor[B, H, S, D; T],
    value: Tensor[B, H, 1, D; T],
    at: i32,
) -> Tensor[B, H, S, D; T]
where S > 0 {
    let positions = iota<i32>(S)
    let out[b, h, s, d] = select(positions[s] == at, value[b, h, 0, d], cache[b, h, s, d])
    return out
}

// `N` consecutive positions of a key/value cache, starting at `at`: what a
// prefill writes, once per layer for the whole prompt rather than once per
// token.
//
// Index notation cannot shift an index by `at`, so each cache position looks
// its value up through an offset tensor, clamped to stay in range, and the
// select keeps the cache outside `[at, at + N)`. A backend with a slice write
// writes only the span.
pub op write_span<B: Dim, H: Dim, S: Dim, N: Dim, D: Dim, T: Float>(
    cache: Tensor[B, H, S, D; T],
    value: Tensor[B, H, N, D; T],
    at: i32,
) -> Tensor[B, H, S, D; T]
where
    S > 0,
    N > 0
{
    let positions = iota<i32>(S)
    let offset[s] = min(max(positions[s] - at, 0), cast<i32>(N) - 1)
    let inside[s] = positions[s] >= at && positions[s] < at + cast<i32>(N)
    let out[b, h, s, d] = select(inside[s], value[b, h, offset[s], d], cache[b, h, s, d])
    return out
}

// One position per sequence: row `b` of the cache is written at `at[b]`.
// A batch decoded together has each sequence at its own length, which is
// what serving many requests at once needs; `write_at` puts every row at
// the same position.
pub op write_rows<B: Dim, H: Dim, S: Dim, D: Dim, T: Float>(
    cache: Tensor[B, H, S, D; T],
    value: Tensor[B, H, 1, D; T],
    at: Tensor[B; i32],
) -> Tensor[B, H, S, D; T]
where S > 0 {
    let positions = iota<i32>(S)
    let out[b, h, s, d] = select(positions[s] == at[b], value[b, h, 0, d], cache[b, h, s, d])
    return out
}

// `N` consecutive positions of one sequence's row, `slot`, starting at `at`:
// a prompt written into its row of a cache the batch shares, leaving every
// other row as it was.
pub op write_slot<B: Dim, H: Dim, S: Dim, N: Dim, D: Dim, T: Float>(
    cache: Tensor[B, H, S, D; T],
    value: Tensor[1, H, N, D; T],
    slot: i32,
    at: i32,
) -> Tensor[B, H, S, D; T]
where
    S > 0,
    N > 0
{
    let rows = iota<i32>(B)
    let positions = iota<i32>(S)
    let offset[s] = min(max(positions[s] - at, 0), cast<i32>(N) - 1)
    let inside[b, s] = rows[b] == slot && positions[s] >= at && positions[s] < at + cast<i32>(N)
    let out[b, h, s, d] = select(inside[b, s], value[0, h, offset[s], d], cache[b, h, s, d])
    return out
}

// `N` consecutive positions from `at` in each of `M` rows, `slots[m]`: the
// prompts of several requests written into their rows of a shared cache in
// one pass. The slots must be distinct.
pub op write_slots<B: Dim, H: Dim, S: Dim, M: Dim, N: Dim, D: Dim, T: Float>(
    cache: Tensor[B, H, S, D; T],
    value: Tensor[M, H, N, D; T],
    slots: Tensor[M; i32],
    at: i32,
) -> Tensor[B, H, S, D; T]
where
    S > 0,
    N > 0,
    M > 0
{
    let rows = iota<i32>(B)
    let positions = iota<i32>(S)
    let offset[s] = min(max(positions[s] - at, 0), cast<i32>(N) - 1)
    let inside[s] = positions[s] >= at && positions[s] < at + cast<i32>(N)
    // Which of the `M` written rows is row `b`, or `M` when none is.
    let hits[b, m] = cast<i32>(slots[m] == rows[b])
    let chosen[b] = sum<i32>[m] hits[b, m] * cast<i32>(iota<i64>(M)[m])
    let written[b] = (sum<i32>[m] hits[b, m]) > 0
    let source[b] = cast<i64>(min(chosen[b], cast<i32>(M) - 1))
    let out[b, h, s, d] = select(
        written[b] && inside[s],
        value[source[b], h, offset[s], d],
        cache[b, h, s, d],
    )
    return out
}

// One position per token, each token in a row of its own choosing: token `p`
// is written into row `rows[p]` at `positions[p]`. Prompts packed end to end
// into one pass -- each token of a prompt goes to that prompt's row, at its
// place in the prompt -- write their keys and values this way. The pairs
// `(rows[p], positions[p])` must be distinct, except that tokens meant to be
// dropped may share one pair nobody reads.
pub op write_tokens<B: Dim, H: Dim, S: Dim, P: Dim, D: Dim, T: Float>(
    cache: Tensor[B, H, S, D; T],
    value: Tensor[1, H, P, D; T],
    rows: Tensor[P; i32],
    positions: Tensor[P; i32],
) -> Tensor[B, H, S, D; T]
where
    S > 0,
    P > 0
{
    let slots = iota<i32>(B)
    let places = iota<i32>(S)
    // Which token lands on row `b` at position `s`, if any.
    let hits[b, s, p] = cast<i32>(rows[p] == slots[b] && positions[p] == places[s])
    let chosen[b, s] = sum<i32>[p] hits[b, s, p] * cast<i32>(iota<i64>(P)[p])
    let written[b, s] = (sum<i32>[p] hits[b, s, p]) > 0
    let source[b, s] = cast<i64>(min(chosen[b, s], cast<i32>(P) - 1))
    let by_token = permute(value, [2, 0, 1, 3])
    let out[b, h, s, d] = select(written[b, s], by_token[source[b, s], 0, h, d], cache[b, h, s, d])
    return out
}

// Where each row's position lies in a pool of pages (paged serving): row
// `b`'s positions run through the pages `table[b]` lists, `Size` positions a
// page, so position `s` is offset `s % Size` of page `table[b, s / Size]`.
// The pool position is that page's start plus the offset.
pub fn page_slots<B: Dim, Pages: Dim, Size: Dim>(
    table: Tensor[B, Pages; i32],
    positions: Tensor[B; i32],
) -> Tensor[B; i32]
where Size > 0 {
    let page[b] = table[b, cast<i64>(positions[b] / cast<i32>(Size))]
    let slot[b] = page[b] * cast<i32>(Size) + positions[b] % cast<i32>(Size)
    return slot
}
