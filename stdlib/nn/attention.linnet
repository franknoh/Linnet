module std.nn.attention

use std.nn.softmax::{softmax}

// A [Q, K] mask that keeps key positions at or before each query position.
// An `op`, so a backend that has a causal attention kernel can recognize the
// mask and drop it.
pub op causal_mask<Q: Dim, K: Dim>() -> Tensor[Q, K; bool] {
    let queries = iota(Q)
    let keys = iota(K)
    let mask[q, k] = keys[k] <= queries[q] + (K - Q)
    return mask
}

// Scaled dot-product attention. Scores are accumulated in f32; masked
// positions receive a large negative score before the softmax.
pub op attention<B: Dim, H: Dim, Q: Dim, K: Dim, D: Dim, T: Float>(
    query: Tensor[B, H, Q, D; T],
    key: Tensor[B, H, K, D; T],
    value: Tensor[B, H, K, D; T],
    scale: f32,
    mask: Tensor[Q, K; bool]? = none,
) -> Tensor[B, H, Q, D; T] {
    let score[b, h, q, k] = sum<f32>[d] cast<f32>(query[b, h, q, d]) * cast<f32>(key[b, h, k, d])
    let scaled = score * scale
    let masked = match mask {
        some(m) => select(m, scaled, fill<f32>([Q, K], -1e30))
        none => scaled
    }
    let weights = softmax(masked)
    let mixed[b, h, q, d] = sum[k] weights[b, h, q, k] * cast<f32>(value[b, h, k, d])
    return cast<T>(mixed)
}

// Attention whose `Hk` key/value heads are shared by `H` query heads
// (grouped-query attention): each key/value head serves `H / Hk` consecutive
// query heads. The canonical body repeats the heads; a kernel that groups
// natively reads them once.
pub op grouped_attention<B: Dim, H: Dim, Hk: Dim, Q: Dim, K: Dim, D: Dim, T: Float>(
    query: Tensor[B, H, Q, D; T],
    key: Tensor[B, Hk, K, D; T],
    value: Tensor[B, Hk, K, D; T],
    scale: f32,
    mask: Tensor[Q, K; bool]? = none,
) -> Tensor[B, H, Q, D; T]
where
    Hk > 0,
    H % Hk == 0
{
    let keys = reshape(
        broadcast_to(reshape(key, [B, Hk, 1, K, D]), [B, Hk, H / Hk, K, D]),
        [B, H, K, D],
    )
    let values = reshape(
        broadcast_to(reshape(value, [B, Hk, 1, K, D]), [B, Hk, H / Hk, K, D]),
        [B, H, K, D],
    )
    return attention(query, keys, values, scale, mask)
}

// Attention with a mask per sequence: `mask[b]` says which keys the queries
// of sequence `b` see. A batch whose sequences sit at different positions
// (each request of a server at its own length) needs one; `attention`'s
// mask is shared by the whole batch.
pub op attention_rows<B: Dim, H: Dim, Q: Dim, K: Dim, D: Dim, T: Float>(
    query: Tensor[B, H, Q, D; T],
    key: Tensor[B, H, K, D; T],
    value: Tensor[B, H, K, D; T],
    scale: f32,
    mask: Tensor[B, Q, K; bool],
) -> Tensor[B, H, Q, D; T] {
    let score[b, h, q, k] = sum<f32>[d] cast<f32>(query[b, h, q, d]) * cast<f32>(key[b, h, k, d])
    let masked[b, h, q, k] = select(mask[b, q, k], score[b, h, q, k] * scale, -1e30)
    let weights = softmax(masked)
    let mixed[b, h, q, d] = sum[k] weights[b, h, q, k] * cast<f32>(value[b, h, k, d])
    return cast<T>(mixed)
}

// `grouped_attention` with a mask per sequence, as `attention_rows`.
pub op grouped_attention_rows<B: Dim, H: Dim, Hk: Dim, Q: Dim, K: Dim, D: Dim, T: Float>(
    query: Tensor[B, H, Q, D; T],
    key: Tensor[B, Hk, K, D; T],
    value: Tensor[B, Hk, K, D; T],
    scale: f32,
    mask: Tensor[B, Q, K; bool],
) -> Tensor[B, H, Q, D; T]
where
    Hk > 0,
    H % Hk == 0
{
    let keys = reshape(
        broadcast_to(reshape(key, [B, Hk, 1, K, D]), [B, Hk, H / Hk, K, D]),
        [B, H, K, D],
    )
    let values = reshape(
        broadcast_to(reshape(value, [B, Hk, 1, K, D]), [B, Hk, H / Hk, K, D]),
        [B, H, K, D],
    )
    return attention_rows(query, keys, values, scale, mask)
}

// Attention with sinks (gpt-oss): one learned logit per query head joins the
// softmax of every row, and its share is then dropped, so a head can attend
// nowhere by putting its mass on the sink and `sum(weights) < 1`. Query heads
// are grouped by the key/value head they share, as in
// `grouped_attention_rows`, and the mask is per sequence.
//
// The sink is written into the denominator -- the maximum subtracted for
// stability is that of the masked scores and the sink together -- rather
// than concatenated as a column and sliced off again. Scores accumulate in
// f32.
pub op sink_attention<B: Dim, Hq: Dim, Hk: Dim, Q: Dim, K: Dim, D: Dim, T: Float>(
    query: Tensor[B, Hq, Q, D; T],
    key: Tensor[B, Hk, K, D; T],
    value: Tensor[B, Hk, K, D; T],
    sinks: Tensor[Hq; T],
    scale: f32,
    mask: Tensor[B, Q, K; bool],
) -> Tensor[B, Hq, Q, D; T]
where
    Hk > 0,
    Hq % Hk == 0
{
    let grouped = reshape(query, [B, Hk, Hq / Hk, Q, D])
    let score[b, g, r, q, k] =
        sum<f32>[d] cast<f32>(grouped[b, g, r, q, d]) * cast<f32>(key[b, g, k, d])
    let scaled = score * scale
    let masked[b, g, r, q, k] = select(mask[b, q, k], scaled[b, g, r, q, k], -1e30)
    let sink = reshape(cast<f32>(sinks), [Hk, Hq / Hk])
    let key_peak[b, g, r, q] = max[k] masked[b, g, r, q, k]
    let peak[b, g, r, q] = max(key_peak[b, g, r, q], sink[g, r])
    let shifted[b, g, r, q, k] = exp(masked[b, g, r, q, k] - peak[b, g, r, q])
    let key_total[b, g, r, q] = sum[k] shifted[b, g, r, q, k]
    let total[b, g, r, q] = key_total[b, g, r, q] + exp(sink[g, r] - peak[b, g, r, q])
    let weights[b, g, r, q, k] = shifted[b, g, r, q, k] / total[b, g, r, q]
    let mixed[b, g, r, q, d] = sum[k] weights[b, g, r, q, k] * cast<f32>(value[b, g, k, d])
    return reshape(cast<T>(mixed), [B, Hq, Q, D])
}

// One query a row over a pool of key/value pages (paged serving): row `b`
// sees its positions up to `positions[b]`, position `s` lying at offset
// `s % Size` of page `table[b, s / Size]` of the pool `key[0]` (`N`
// positions, `Size` a page). Rows take pages as they grow, so the cache
// holds what the rows use rather than a full row each. Query heads share
// key/value heads as in `grouped_attention_rows`.
//
// The canonical body gathers each row's positions out of the pool and
// attends over them; a backend with a paged kernel reads the pages where
// they lie.
pub op paged_attention<B: Dim, Hq: Dim, Hk: Dim, N: Dim, Pages: Dim, Size: Dim, D: Dim, T: Float>(
    query: Tensor[B, Hq, 1, D; T],
    key: Tensor[1, Hk, N, D; T],
    value: Tensor[1, Hk, N, D; T],
    table: Tensor[B, Pages; i32],
    positions: Tensor[B; i32],
    scale: f32,
) -> Tensor[B, Hq, 1, D; T]
where
    Hk > 0,
    Hq % Hk == 0,
    Size > 0
{
    let logical = iota<i32>(Pages * Size)
    let page[b, s] = table[b, cast<i64>(logical[s] / cast<i32>(Size))]
    let at[b, s] = cast<i64>(page[b, s] * cast<i32>(Size) + logical[s] % cast<i32>(Size))
    let keys[b, h, s, d] = key[0, h, at[b, s], d]
    let values[b, h, s, d] = value[0, h, at[b, s], d]
    let seen[b, s] = logical[s] <= positions[b]
    return grouped_attention_rows(query, keys, values, scale, reshape(seen, [B, 1, Pages * Size]))
}

// Prompt tokens packed end to end over the same pool (paged serving): token
// `p`, at position `positions[p]` of row `rows[p]`, sees that row's
// positions up to its own, in the pages `table[rows[p]]` lists. The pass's
// own tokens are expected in the pool already, beside what earlier passes
// wrote there: the start of a prompt passed in chunks, or pages a row shares
// with another (a common prefix).
//
// The canonical body is `paged_attention` with each token a row of its own;
// a backend with a paged kernel reads each page once for the tokens that see
// it.
pub op paged_prefill_attention<
    P: Dim,
    Hq: Dim,
    Hk: Dim,
    N: Dim,
    Rows: Dim,
    Pages: Dim,
    Size: Dim,
    D: Dim,
    T: Float,
>(
    query: Tensor[1, Hq, P, D; T],
    key: Tensor[1, Hk, N, D; T],
    value: Tensor[1, Hk, N, D; T],
    table: Tensor[Rows, Pages; i32],
    rows: Tensor[P; i32],
    positions: Tensor[P; i32],
    scale: f32,
) -> Tensor[1, Hq, P, D; T]
where
    Hk > 0,
    Hq % Hk == 0,
    Size > 0
{
    let tables[p, j] = table[cast<i64>(rows[p]), j]
    let each = paged_attention<P, Hq, Hk, N, Pages, Size, D, T>(
        permute(query, [2, 1, 0, 3]),
        key,
        value,
        tables,
        positions,
        scale,
    )
    return permute(each, [2, 1, 0, 3])
}
