module std.quant

use std.nn.linear::{linear}
use std.nn.moe::{combine_experts, linear_experts_shared}

// Weight quantization as ordinary source: a quantized parameter is an
// integer tensor plus its scales, and dequantization is arithmetic the
// checker sees like any other. Nothing here asks a backend for a special
// kernel; a backend that has one may select it as a candidate.

// Symmetric per-row int8: `weight[o, i] = q[o, i] * scale[o]`.
pub op dequantize_int8<*S: Shape, N: Dim, T: Float>(
    q: Tensor[*S, N; i8],
    scale: Tensor[*S; f32],
) -> Tensor[*S, N; T] {
    let scaled[*s, n] = cast<f32>(q[*s, n]) * scale[*s]
    return cast<T>(scaled)
}

// Two signed 4-bit values per byte of a `[Rows, Half]` matrix: the low nibble
// is element `2k` of the row, the high nibble element `2k + 1`, both in
// `-8..7`.
pub op unpack_int4<R: Dim, H: Dim>(packed: Tensor[R, H; i8]) -> Tensor[R, 2 * H; i8] {
    let wide = cast<i32>(packed)
    let low = wide & 15
    let high = shr(wide, 4) & 15
    let low_signed = select(low >= 8, low - 16, low)
    let high_signed = select(high >= 8, high - 16, high)
    let pairs = concat(reshape(low_signed, [R, H, 1]), reshape(high_signed, [R, H, 1]), axis = -1)
    return cast<i8>(reshape(pairs, [R, 2 * H]))
}

// Symmetric per-row int4 packed two per byte: `Half` bytes hold `2 * Half`
// weights of each row.
pub op dequantize_int4<R: Dim, H: Dim, T: Float>(
    packed: Tensor[R, H; i8],
    scale: Tensor[R; f32],
) -> Tensor[R, 2 * H; T] {
    return dequantize_int8<[R], 2 * H, T>(unpack_int4(packed), scale)
}

// A linear layer whose weight is stored as per-row int8.
pub block Int8Linear<In: Dim, Out: Dim, T: Float = bf16> {
    param weight: Tensor[Out, In; i8]
    param scale: Tensor[Out; f32]
    param bias: Tensor[Out; T]? = none

    pub fn forward<*S: Shape>(x: Tensor[*S, In; T]) -> Tensor[*S, Out; T] {
        return linear(x, dequantize_int8<[Out], In, T>(weight, scale), bias)
    }
}

// A linear layer whose weight is stored as per-row int4, two per byte.
pub block Int4Linear<In: Dim, Out: Dim, T: Float = bf16>
where In % 2 == 0 {
    param weight: Tensor[Out, In / 2; i8]
    param scale: Tensor[Out; f32]
    param bias: Tensor[Out; T]? = none

    pub fn forward<*S: Shape>(x: Tensor[*S, In; T]) -> Tensor[*S, Out; T] {
        return linear(x, dequantize_int4<Out, In / 2, T>(weight, scale), bias)
    }
}

// Asymmetric 4-bit weights in groups of `2 * Half` consecutive inputs,
// stored as `[Out, Groups, Half]` bytes: each byte holds two weights of its
// group, the low nibble first, in `0..15`, and
// `weight[o, i] = (q[o, i] - zero[o, g]) * scale[o, g]` with `g` the group of
// input `i`. ONNX Runtime's `MatMulNBits` reads this layout as it is;
// GPTQ- and AWQ-style checkpoints repack into it.
pub op dequantize_int4_groups<Out: Dim, Groups: Dim, Half: Dim, T: Float>(
    packed: Tensor[Out, Groups, Half; u8],
    scale: Tensor[Out, Groups; T],
    zero: Tensor[Out, Groups; u8],
) -> Tensor[Out, Groups * (2 * Half); T] {
    let low[o, g, j] = cast<f32>(cast<i32>(packed[o, g, j]) & 15)
    let high[o, g, j] = cast<f32>(shr(cast<i32>(packed[o, g, j]), 4) & 15)
    let pairs = concat(
        reshape(low, [Out, Groups, Half, 1]),
        reshape(high, [Out, Groups, Half, 1]),
        axis = -1,
    )
    let q = reshape(pairs, [Out, Groups, 2 * Half])
    let weight[o, g, j] = (q[o, g, j] - cast<f32>(zero[o, g])) * cast<f32>(scale[o, g])
    return cast<T>(reshape(weight, [Out, Groups * (2 * Half)]))
}

// A linear layer over group-wise 4-bit weights. Its body dequantizes and
// multiplies; a backend with a fused 4-bit matrix product (PyTorch's on
// CUDA, ONNX Runtime's `MatMulNBits`) runs that instead, reading the packed
// weights as they are.
pub op linear_int4_groups<*S: Shape, Out: Dim, Groups: Dim, Half: Dim, T: Float>(
    x: Tensor[*S, Groups * (2 * Half); T],
    packed: Tensor[Out, Groups, Half; u8],
    scale: Tensor[Out, Groups; T],
    zero: Tensor[Out, Groups; u8],
    bias: Tensor[Out; T]?,
) -> Tensor[*S, Out; T] {
    return linear(x, dequantize_int4_groups<Out, Groups, Half, T>(packed, scale, zero), bias)
}

// `x`'s last axis in `order`: element `k` of the result is input `order[k]`.
pub op take_inputs<*S: Shape, N: Dim, T: Float>(
    x: Tensor[*S, N; T],
    order: Tensor[N; i32],
) -> Tensor[*S, N; T] {
    let taken[*s, k] = x[*s, cast<i64>(order[k])]
    return taken
}

// A linear layer whose weight is stored as group-wise asymmetric int4, in
// groups of `Group` inputs. With `order`, the groups were formed over the
// inputs taken in that order (GPTQ's activation order): the packed row's
// `k`-th weight is input `order[k]`'s, so the inputs are taken in that order
// first.
pub block Int4GroupLinear<In: Dim, Out: Dim, Group: Dim = 128, T: Float = bf16>
where
    Group > 0,
    Group % 2 == 0,
    In % Group == 0
{
    param weight: Tensor[Out, In / Group, Group / 2; u8]
    param scale: Tensor[Out, In / Group; T]
    param zero: Tensor[Out, In / Group; u8]
    param order: Tensor[In; i32]? = none
    param bias: Tensor[Out; T]? = none

    pub fn forward<*S: Shape>(x: Tensor[*S, In; T]) -> Tensor[*S, Out; T] {
        let taken = match order {
            some(o) => take_inputs(x, o)
            none => x
        }
        return linear_int4_groups(taken, weight, scale, zero, bias)
    }
}

// MXFP4, the format OpenAI's gpt-oss checkpoints publish their expert
// weights in. A row of `N` weights is cut into blocks of 32. Each block is 16
// bytes, two four-bit values per byte, plus one byte of scale: `4 + 8/32 =
// 4.25` bits per weight. The checkpoint stores the two parts as separate
// tensors, `..._blocks` of shape `[Experts, Rows, N / 32, 16]` and
// `..._scales` of shape `[Experts, Rows, N / 32]`, both `u8`; the arithmetic
// below is what turns them into weights.
//
// One `u8` block byte holds two FP4 (E2M1) values: the low nibble is element
// `2k` of the block, the high nibble element `2k + 1`. A nibble is a sign
// bit, two exponent bits, and one mantissa bit, which spells out sixteen
// values: `0, 0.5, 1, 1.5, 2, 3, 4, 6` and their negatives. The reference
// implementation reads them from a lookup table; the language has no tensor
// data in source, so they are computed instead. Twice each value is an
// integer in `0..12`, so `doubled` stays in one byte and the only float
// arithmetic is the final scaling.
//
// One `u8` scale byte per block is an E8M0 exponent, biased by 127: the
// block's weights are its FP4 values times `2 ** (scale - 127)`. That power
// of two is built from integer shifts rather than `exp`, so it is exact. The
// shifts saturate at `2 ** 62` in either direction, which keeps the shift
// counts inside `i64`; every scale byte in this checkpoint's 96 expert scale
// tensors lies in 115..136, that is `2 ** -12` to `2 ** 9`, so the saturation
// is never reached. A checkpoint that did reach it would need the product of
// two such factors instead of one.
//
// The result is `[Experts, Rows, N]`, the layout the checkpoint names: `Rows`
// is the output width of the projection and `N` its input width. The
// reference transposes the last two axes to suit its own parameter; the
// contractions in `gpt_oss.experts` read this layout as it stands instead.
pub op dequantize_mxfp4<Experts: Dim, Rows: Dim, G: Dim, T: Float>(
    blocks: Tensor[Experts, Rows, G, 16; u8],
    scales: Tensor[Experts, Rows, G; u8],
) -> Tensor[Experts, Rows, G * 32; T] {
    let low = blocks & 15
    let high = shr(blocks, 4) & 15
    let interleaved = concat(
        reshape(low, [Experts, Rows, G, 16, 1]),
        reshape(high, [Experts, Rows, G, 16, 1]),
        axis = -1,
    )
    let nibbles = reshape(interleaved, [Experts, Rows, G, 32])
    let exponent = shr(nibbles, 1) & 3
    let mantissa = nibbles & 1
    let doubled = select(
        exponent == 0,
        mantissa,
        shl(1, exponent) + shl(mantissa, max(exponent - 1, 0)),
    )
    let signed = select((nibbles & 8) == 0, cast<i8>(doubled), -cast<i8>(doubled))
    let biased = cast<i32>(scales) - 127
    let up = cast<f32>(shl(cast<i64>(1), cast<i64>(min(max(biased, 0), 62))))
    let down = cast<f32>(shl(cast<i64>(1), cast<i64>(min(max(-biased, 0), 62))))
    // The 0.5 undoes the doubling `doubled` carries; both factors are powers
    // of two, so `T` holds the product exactly for every FP4 value.
    let factor = cast<T>(up / down * 0.5)
    let value[e, r, g, b] = cast<T>(signed[e, r, g, b]) * factor[e, r, g]
    return reshape(value, [Experts, Rows, G * 32])
}

// `std.nn.moe::linear_experts` with the experts' weights in MXFP4: row `r`'s
// `k`-th input times its `k`-th chosen expert, `y[r, k, o] = sum_i x[r, k, i]
// * W[experts[r, k], o, i]`, `W` as `dequantize_mxfp4` reads `blocks` and
// `scales`. The body dequantizes, gathers the chosen experts and multiplies,
// accumulating in f32; PyTorch on CUDA reads the chosen experts' four-bit
// blocks and scales as they are, a quarter of the bytes of 16-bit weights,
// and unpacks them in registers.
pub op mxfp4_experts<R: Dim, K: Dim, E: Dim, Out: Dim, G: Dim, T: Float>(
    x: Tensor[R, K, G * 32; T],
    blocks: Tensor[E, Out, G, 16; u8],
    scales: Tensor[E, Out, G; u8],
    experts: Tensor[R, K; i64],
) -> Tensor[R, K, Out; T] {
    let weight = dequantize_mxfp4<E, Out, G, T>(blocks, scales)
    let chosen[r, k, o, i] = weight[experts[r, k], o, i]
    let y[r, k, o] = sum<f32>[i] cast<f32>(x[r, k, i]) * cast<f32>(chosen[r, k, o, i])
    return cast<T>(y)
}

// `mxfp4_experts` for an input every chosen expert of a row shares -- a
// mixture's gate and up projections: `y[r, k, o] = sum_i x[r, 0, i] *
// W[experts[r, k], o, i]`, the input one position per row as a decoder holds
// a token. Indexed at that position, the input multiplies the gathered
// weights elementwise before the sum, which XLA fuses into one pass over the
// chosen experts.
pub op mxfp4_experts_shared<R: Dim, K: Dim, E: Dim, Out: Dim, G: Dim, T: Float>(
    x: Tensor[R, 1, G * 32; T],
    blocks: Tensor[E, Out, G, 16; u8],
    scales: Tensor[E, Out, G; u8],
    experts: Tensor[R, K; i64],
) -> Tensor[R, K, Out; T] {
    let weight = dequantize_mxfp4<E, Out, G, T>(blocks, scales)
    let chosen[r, k, o, i] = weight[experts[r, k], o, i]
    let y[r, k, o] = sum<f32>[i] cast<f32>(x[r, 0, i]) * cast<f32>(chosen[r, k, o, i])
    return cast<T>(y)
}

// `std.nn.moe::linear_experts_shared` with the experts' weights in MXFP4: a
// mixture's gate and up projections for many rows at once -- a prompt, a
// serving step -- `y[r, k, o] = sum_i x[r, i] * W[experts[r, k], o, i]`.
// The body dequantizes every expert and takes `linear_experts_shared`'s
// dense form, which a backend that prepares weight-only work does once at
// load; PyTorch on CUDA instead multiplies each expert by the rows that
// chose it, unpacking its four-bit blocks in registers.
pub op mxfp4_linear_experts_shared<R: Dim, K: Dim, E: Dim, Out: Dim, G: Dim, T: Float>(
    x: Tensor[R, G * 32; T],
    blocks: Tensor[E, Out, G, 16; u8],
    scales: Tensor[E, Out, G; u8],
    experts: Tensor[R, K; i64],
) -> Tensor[R, K, Out; T] {
    return linear_experts_shared(x, dequantize_mxfp4<E, Out, G, T>(blocks, scales), experts)
}

// `std.nn.moe::combine_experts` with the experts' weights in MXFP4: a
// mixture's down projection for many rows at once,
// `y[r, o] = sum_k weights[r, k] * sum_i x[r, k, i] * W[experts[r, k], o, i]`,
// as `mxfp4_linear_experts_shared` is to `linear_experts_shared`.
pub op mxfp4_combine_experts<R: Dim, K: Dim, E: Dim, Out: Dim, G: Dim, T: Float>(
    x: Tensor[R, K, G * 32; T],
    blocks: Tensor[E, Out, G, 16; u8],
    scales: Tensor[E, Out, G; u8],
    experts: Tensor[R, K; i64],
    weights: Tensor[R, K; T],
) -> Tensor[R, Out; T] {
    return combine_experts(x, dequantize_mxfp4<E, Out, G, T>(blocks, scales), experts, weights)
}
