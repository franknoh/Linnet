module std.quant

use std.dtypes::{f4e2m1, f8e4m3, i4, nf4, u4}
use std.nn.linear::{linear}
use std.nn.moe::{combine_experts, linear_experts, linear_experts_shared}

// Weight quantization as ordinary source: a quantized parameter is a tensor
// of a narrow format (`i8`, or one of `std.dtypes`) plus its scales, and
// dequantization is a cast and arithmetic the checker sees like any other.
// Nothing here asks a backend for a special kernel; a backend that has one
// may select it as a candidate.

// Symmetric per-row int8: `weight[o, i] = q[o, i] * scale[o]`.
pub op dequantize_int8<*S: Shape, N: Dim, T: Float>(
    q: Tensor[*S, N; i8],
    scale: Tensor[*S; f32],
) -> Tensor[*S, N; T] {
    let scaled[*s, n] = cast<f32>(q[*s, n]) * scale[*s]
    return cast<T>(scaled)
}

// Symmetric per-row int4 (`std.dtypes::i4`, two values a byte):
// `weight[r, n] = q[r, n] * scale[r]`.
pub op dequantize_int4<R: Dim, N: Dim, T: Float>(
    q: Tensor[R, N; i4],
    scale: Tensor[R; f32],
) -> Tensor[R, N; T] {
    return dequantize_int8<[R], N, T>(cast<i8>(q), scale)
}

// A linear layer over per-row int8 weights. Its body dequantizes the weight
// and multiplies in `T`. PyTorch on CUDA multiplies the int8 weight as it
// is; under `numerics="fast"`, a call of more than 32 rows also rounds each
// row of `x` to int8 with a scale of its own (the largest magnitude over
// 127) and multiplies the two in int8.
pub op linear_int8<*S: Shape, In: Dim, Out: Dim, T: Float>(
    x: Tensor[*S, In; T],
    weight: Tensor[Out, In; i8],
    scale: Tensor[Out; T],
    bias: Tensor[Out; T]?,
) -> Tensor[*S, Out; T] {
    return linear(x, dequantize_int8<[Out], In, T>(weight, cast<f32>(scale)), bias)
}

// A linear layer whose weight is stored as per-row int8, as
// `compressed-tensors` checkpoints store it (`weight`, and `weight_scale` of
// shape `[Out, 1]` in the model's dtype).
pub block Int8Linear<In: Dim, Out: Dim, T: Float = bf16> {
    param weight: Tensor[Out, In; i8]
    param scale: Tensor[Out, 1; T]
    param bias: Tensor[Out; T]? = none

    pub fn forward<*S: Shape>(x: Tensor[*S, In; T]) -> Tensor[*S, Out; T] {
        return linear_int8(x, weight, reshape(scale, [Out]), bias)
    }
}

// Symmetric int8 in groups of `Group` consecutive inputs:
// `weight[o, i] = q[o, i] * scale[o, i / Group]`.
pub op dequantize_int8_groups<Out: Dim, Groups: Dim, Group: Dim, T: Float>(
    q: Tensor[Out, Groups * Group; i8],
    scale: Tensor[Out, Groups; T],
) -> Tensor[Out, Groups * Group; T] {
    let grouped = reshape(cast<f32>(q), [Out, Groups, Group])
    let scaled[o, g, j] = grouped[o, g, j] * cast<f32>(scale[o, g])
    return cast<T>(reshape(scaled, [Out, Groups * Group]))
}

// A linear layer over group-wise int8 weights. Its body dequantizes and
// multiplies; PyTorch on CUDA multiplies the int8 weight as it is, scaling
// each group as it reads it.
pub op linear_int8_groups<Group: Dim, *S: Shape, Out: Dim, Groups: Dim, T: Float>(
    x: Tensor[*S, Groups * Group; T],
    weight: Tensor[Out, Groups * Group; i8],
    scale: Tensor[Out, Groups; T],
    bias: Tensor[Out; T]?,
) -> Tensor[*S, Out; T] {
    return linear(x, dequantize_int8_groups<Out, Groups, Group, T>(weight, scale), bias)
}

// A linear layer whose weight is stored as symmetric int8 with one scale
// for each `Group` consecutive inputs of a row (`compressed-tensors`'
// `int-quantized` group strategy: `weight` and `weight_scale` of shape
// `[Out, In / Group]`).
pub block Int8GroupLinear<In: Dim, Out: Dim, Group: Dim = 128, T: Float = bf16>
where
    Group > 0,
    In % Group == 0
{
    param weight: Tensor[Out, In; i8]
    param scale: Tensor[Out, In / Group; T]
    param bias: Tensor[Out; T]? = none

    pub fn forward<*S: Shape>(x: Tensor[*S, In; T]) -> Tensor[*S, Out; T] {
        return linear_int8_groups<Group>(x, weight, scale, bias)
    }
}

// A linear layer whose weight is stored as per-row int4, with one scale a
// row as the 8-bit layers store theirs (`[Out, 1]` in `T`).
pub block Int4Linear<In: Dim, Out: Dim, T: Float = bf16>
where In % 2 == 0 {
    param weight: Tensor[Out, In; i4]
    param scale: Tensor[Out, 1; T]
    param bias: Tensor[Out; T]? = none

    pub fn forward<*S: Shape>(x: Tensor[*S, In; T]) -> Tensor[*S, Out; T] {
        let rows = cast<f32>(reshape(scale, [Out]))
        return linear(x, dequantize_int4<Out, In, T>(weight, rows), bias)
    }
}

// Asymmetric 4-bit weights (`std.dtypes::u4`, in `0..15`) in groups of
// `Group` consecutive inputs, stored `[Out, Groups, Group]`:
// `weight[o, i] = (q[o, i] - zero[o, g]) * scale[o, g]` with `g` the group of
// input `i`. Its bytes are ONNX Runtime's `MatMulNBits` layout; GPTQ- and
// AWQ-style checkpoints repack into it.
pub op dequantize_int4_groups<Out: Dim, Groups: Dim, Group: Dim, T: Float>(
    q: Tensor[Out, Groups, Group; u4],
    scale: Tensor[Out, Groups; T],
    zero: Tensor[Out, Groups; u8],
) -> Tensor[Out, Groups * Group; T] {
    let wide = cast<f32>(q)
    let weight[o, g, j] = (wide[o, g, j] - cast<f32>(zero[o, g])) * cast<f32>(scale[o, g])
    return cast<T>(reshape(weight, [Out, Groups * Group]))
}

// A linear layer over group-wise 4-bit weights. Its body dequantizes and
// multiplies; a backend with a fused 4-bit matrix product (PyTorch's on
// CUDA, ONNX Runtime's `MatMulNBits`) runs that instead, reading the packed
// weights as they are.
pub op linear_int4_groups<*S: Shape, Out: Dim, Groups: Dim, Group: Dim, T: Float>(
    x: Tensor[*S, Groups * Group; T],
    q: Tensor[Out, Groups, Group; u4],
    scale: Tensor[Out, Groups; T],
    zero: Tensor[Out, Groups; u8],
    bias: Tensor[Out; T]?,
) -> Tensor[*S, Out; T] {
    return linear(x, dequantize_int4_groups<Out, Groups, Group, T>(q, scale, zero), bias)
}

// `x`'s last axis in `order`: element `k` of the result is input `order[k]`.
pub op take_inputs<*S: Shape, N: Dim, T: Float>(
    x: Tensor[*S, N; T],
    order: Tensor[N; i32],
) -> Tensor[*S, N; T] {
    let taken[*s, k] = x[*s, cast<i64>(order[k])]
    return taken
}

// A linear layer whose weight is stored as group-wise asymmetric int4, in
// groups of `Group` inputs. With `order`, the groups were formed over the
// inputs taken in that order (GPTQ's activation order): the packed row's
// `k`-th weight is input `order[k]`'s, so the inputs are taken in that order
// first.
pub block Int4GroupLinear<In: Dim, Out: Dim, Group: Dim = 128, T: Float = bf16>
where
    Group > 0,
    Group % 2 == 0,
    In % Group == 0
{
    param weight: Tensor[Out, In / Group, Group; u4]
    param scale: Tensor[Out, In / Group; T]
    param zero: Tensor[Out, In / Group; u8]
    param order: Tensor[In; i32]? = none
    param bias: Tensor[Out; T]? = none

    pub fn forward<*S: Shape>(x: Tensor[*S, In; T]) -> Tensor[*S, Out; T] {
        let taken = match order {
            some(o) => take_inputs(x, o)
            none => x
        }
        return linear_int4_groups(taken, weight, scale, zero, bias)
    }
}

// NF4 (`std.dtypes::nf4`, QLoRA's 4-bit NormalFloat) in blocks of `Block`
// consecutive inputs, one scale a block, the block's largest magnitude:
// `weight[o, i] = nf4(q[o, i]) * absmax[o, i / Block]`.
pub op dequantize_nf4<Out: Dim, Blocks: Dim, Block: Dim, T: Float>(
    q: Tensor[Out, Blocks * Block; nf4],
    absmax: Tensor[Out, Blocks; f32],
) -> Tensor[Out, Blocks * Block; T] {
    let values = reshape(cast<f32>(q), [Out, Blocks, Block])
    let scaled[o, b, j] = values[o, b, j] * absmax[o, b]
    return cast<T>(reshape(scaled, [Out, Blocks * Block]))
}

// A linear layer over NF4 weights, one scale for each `Block` consecutive
// inputs of a row. Its body widens the weight and multiplies in `T`; a
// backend with a 4-bit product may take the call instead.
pub op linear_nf4<Block: Dim, *S: Shape, Out: Dim, Blocks: Dim, T: Float>(
    x: Tensor[*S, Blocks * Block; T],
    q: Tensor[Out, Blocks * Block; nf4],
    absmax: Tensor[Out, Blocks; f32],
    bias: Tensor[Out; T]?,
) -> Tensor[*S, Out; T] {
    return linear(x, dequantize_nf4<Out, Blocks, Block, T>(q, absmax), bias)
}

// A linear layer whose weight is stored as NF4 with one scale for each
// `Block` consecutive inputs of a row, as bitsandbytes' 4-bit layers keep
// them (`linnet.quant.import_quantized` repacks such a checkpoint for it).
pub block Nf4Linear<In: Dim, Out: Dim, Block: Dim = 64, T: Float = bf16>
where
    Block > 0,
    Block % 2 == 0,
    In % Block == 0
{
    param weight: Tensor[Out, In; nf4]
    param absmax: Tensor[Out, In / Block; f32]
    param bias: Tensor[Out; T]? = none

    pub fn forward<*S: Shape>(x: Tensor[*S, In; T]) -> Tensor[*S, Out; T] {
        return linear_nf4<Block>(x, weight, absmax, bias)
    }
}

// FP8 E4M3 (`float8_e4m3fn`, `std.dtypes::f8e4m3`), one byte a value: a
// sign bit, four exponent bits biased by 7, and three mantissa bits, with no
// infinities. The layers below take `f8e4m3` weights and cast them. A
// checkpoint's `F8_E4M3` tensor also binds to a `u8` parameter as its bytes,
// which `decode_fp8` decodes: a normal value is `(8 + m) * 2 ** (e - 10)`
// and a subnormal one (`e == 0`) `m * 2 ** -9`; the powers of two come from
// integer shifts, so every value is exact in `f32`. The one NaN byte pattern
// (`e == 15`, `m == 7`) reads as 480; checkpoints never hold it.
pub op decode_fp8<*S: Shape>(bits: Tensor[*S; u8]) -> Tensor[*S; f32] {
    let wide = cast<i32>(bits)
    let exponent = shr(wide, 3) & 15
    let mantissa = wide & 7
    let magnitude = select(exponent == 0, mantissa, mantissa + 8)
    let power = cast<f32>(shl(1, max(exponent, 1) - 1)) * 0.001953125
    let value = cast<f32>(magnitude) * power
    return select((wide & 128) == 0, value, -value)
}

// Per-row FP8 E4M3: `weight[o, i] = q[o, i] * scale[o]`.
pub op dequantize_fp8<*S: Shape, N: Dim, T: Float>(
    q: Tensor[*S, N; f8e4m3],
    scale: Tensor[*S; f32],
) -> Tensor[*S, N; T] {
    let decoded = cast<f32>(q)
    let scaled[*s, n] = decoded[*s, n] * scale[*s]
    return cast<T>(scaled)
}

// A linear layer over per-row FP8 E4M3 weights. Its body decodes the weight
// and multiplies in `T`. PyTorch on a GPU that converts FP8 (compute
// capability 8.9 or later) multiplies the FP8 weight as it is; under
// `numerics="fast"`, with FP8 products (9.0), a call of more than 32 rows
// also rounds each row of `x` to FP8 with a scale of its own and multiplies
// the two in FP8.
pub op linear_fp8<*S: Shape, In: Dim, Out: Dim, T: Float>(
    x: Tensor[*S, In; T],
    weight: Tensor[Out, In; f8e4m3],
    scale: Tensor[Out; T],
    bias: Tensor[Out; T]?,
) -> Tensor[*S, Out; T] {
    return linear(x, dequantize_fp8<[Out], In, T>(weight, cast<f32>(scale)), bias)
}

// A linear layer whose weight is stored as FP8 E4M3 with one scale a row,
// as `compressed-tensors` checkpoints store it (`weight`, and `weight_scale`
// of shape `[Out, 1]` in the model's dtype).
pub block Fp8Linear<In: Dim, Out: Dim, T: Float = bf16> {
    param weight: Tensor[Out, In; f8e4m3]
    param scale: Tensor[Out, 1; T]
    param bias: Tensor[Out; T]? = none

    pub fn forward<*S: Shape>(x: Tensor[*S, In; T]) -> Tensor[*S, Out; T] {
        return linear_fp8(x, weight, reshape(scale, [Out]), bias)
    }
}

// FP8 E4M3 in square blocks of `Block` rows by `Block` inputs, one scale a
// block: `weight[o, i] = q[o, i] * scale[o / Block, i / Block]`.
pub op dequantize_fp8_blocks<RowBlocks: Dim, ColBlocks: Dim, Block: Dim, T: Float>(
    q: Tensor[RowBlocks * Block, ColBlocks * Block; f8e4m3],
    scale: Tensor[RowBlocks, ColBlocks; T],
) -> Tensor[RowBlocks * Block, ColBlocks * Block; T] {
    let decoded = reshape(cast<f32>(q), [RowBlocks, Block, ColBlocks, Block])
    let scaled[r, i, c, j] = decoded[r, i, c, j] * cast<f32>(scale[r, c])
    return cast<T>(reshape(scaled, [RowBlocks * Block, ColBlocks * Block]))
}

// A linear layer over block-scaled FP8 E4M3 weights. Its body decodes the
// weight and multiplies in `T`. PyTorch on a GPU with FP8 products
// multiplies the FP8 weight as it is; under `numerics="fast"`, in bf16, a
// call of more than 32 rows also rounds each `Block` inputs of a row of `x`
// to FP8 with a scale of their own, and multiplies the two in FP8.
pub op linear_fp8_blocks<Block: Dim, *S: Shape, RowBlocks: Dim, ColBlocks: Dim, T: Float>(
    x: Tensor[*S, ColBlocks * Block; T],
    weight: Tensor[RowBlocks * Block, ColBlocks * Block; f8e4m3],
    scale: Tensor[RowBlocks, ColBlocks; T],
    bias: Tensor[RowBlocks * Block; T]?,
) -> Tensor[*S, RowBlocks * Block; T] {
    let decoded = dequantize_fp8_blocks<RowBlocks, ColBlocks, Block, T>(weight, scale)
    return linear(x, decoded, bias)
}

// A linear layer whose weight is stored as FP8 E4M3 with one scale for
// each `Block` by `Block` block, as DeepSeek-V3 and Qwen3's FP8 checkpoints
// store it (`weight`, and `weight_scale_inv` of shape
// `[Out / 128, In / 128]`, a multiplier despite its name).
pub block Fp8BlockLinear<In: Dim, Out: Dim, Block: Dim = 128, T: Float = bf16>
where
    Block > 0,
    In % Block == 0,
    Out % Block == 0
{
    param weight: Tensor[Out, In; f8e4m3]
    param scale: Tensor[Out / Block, In / Block; T]
    param bias: Tensor[Out; T]? = none

    pub fn forward<*S: Shape>(x: Tensor[*S, In; T]) -> Tensor[*S, Out; T] {
        return linear_fp8_blocks<Block>(x, weight, scale, bias)
    }
}

// MXFP4, the format OpenAI's gpt-oss checkpoints publish their expert
// weights in. A row of `N` weights is cut into blocks of 32 FP4 E2M1 values
// (`std.dtypes::f4e2m1`, two a byte: 16 bytes a block), plus one byte of
// scale: `4 + 8/32 = 4.25` bits per weight. The checkpoint stores the two
// parts as separate tensors, `..._blocks` of bytes `[Experts, Rows, N / 32,
// 16]` (here `[Experts, Rows, N / 32, 32; f4e2m1]`) and `..._scales` of
// shape `[Experts, Rows, N / 32]`, `u8`.
//
// One `u8` scale byte per block is an E8M0 exponent, biased by 127: the
// block's weights are its FP4 values times `2 ** (scale - 127)`. That power
// of two is built from integer shifts rather than `exp`, so it is exact. The
// shifts saturate at `2 ** 62` in either direction, which keeps the shift
// counts inside `i64`; every scale byte in gpt-oss-20b's 96 expert scale
// tensors lies in 115..136, that is `2 ** -12` to `2 ** 9`, so the saturation
// is never reached. A checkpoint that did reach it would need the product of
// two such factors instead of one.
//
// The result is `[Experts, Rows, N]`, the layout the checkpoint names: `Rows`
// is the output width of the projection and `N` its input width. The
// reference transposes the last two axes to suit its own parameter;
// `mxfp4_experts` and the ops after it read this layout as it stands.
pub op dequantize_mxfp4<Experts: Dim, Rows: Dim, G: Dim, T: Float>(
    blocks: Tensor[Experts, Rows, G, 32; f4e2m1],
    scales: Tensor[Experts, Rows, G; u8],
) -> Tensor[Experts, Rows, G * 32; T] {
    let values = cast<f32>(blocks)
    let biased = cast<i32>(scales) - 127
    let up = cast<f32>(shl(cast<i64>(1), cast<i64>(min(max(biased, 0), 62))))
    let down = cast<f32>(shl(cast<i64>(1), cast<i64>(min(max(-biased, 0), 62))))
    // Both factors are powers of two, so `f32` holds the product exactly and
    // `T` holds every FP4 value scaled by it.
    let factor = up / down
    let value[e, r, g, b] = cast<T>(values[e, r, g, b] * factor[e, r, g])
    return reshape(value, [Experts, Rows, G * 32])
}

// `std.nn.moe::linear_experts` with the experts' weights in MXFP4: row `r`'s
// `k`-th input times its `k`-th chosen expert, `y[r, k, o] = sum_i x[r, k, i]
// * W[experts[r, k], o, i]`, `W` as `dequantize_mxfp4` reads `blocks` and
// `scales`. The body dequantizes and takes `linear_experts`' form, gathering
// the chosen experts and accumulating in f32; PyTorch on CUDA reads the
// chosen experts' four-bit blocks and scales as they are, a quarter of the
// bytes of 16-bit weights, and unpacks them in registers.
pub op mxfp4_experts<R: Dim, K: Dim, E: Dim, Out: Dim, G: Dim, T: Float>(
    x: Tensor[R, K, G * 32; T],
    blocks: Tensor[E, Out, G, 32; f4e2m1],
    scales: Tensor[E, Out, G; u8],
    experts: Tensor[R, K; i64],
) -> Tensor[R, K, Out; T] {
    return linear_experts(x, dequantize_mxfp4<E, Out, G, T>(blocks, scales), experts)
}

// `mxfp4_experts` for an input every chosen expert of a row shares -- a
// mixture's gate and up projections: `y[r, k, o] = sum_i x[r, 0, i] *
// W[experts[r, k], o, i]`, the input one position per row as a decoder holds
// a token. Indexed at that position, the input multiplies the gathered
// weights elementwise before the sum, which XLA fuses into one pass over the
// chosen experts.
pub op mxfp4_experts_shared<R: Dim, K: Dim, E: Dim, Out: Dim, G: Dim, T: Float>(
    x: Tensor[R, 1, G * 32; T],
    blocks: Tensor[E, Out, G, 32; f4e2m1],
    scales: Tensor[E, Out, G; u8],
    experts: Tensor[R, K; i64],
) -> Tensor[R, K, Out; T] {
    let weight = dequantize_mxfp4<E, Out, G, T>(blocks, scales)
    let chosen[r, k, o, i] = weight[experts[r, k], o, i]
    let y[r, k, o] = sum<f32>[i] cast<f32>(x[r, 0, i]) * cast<f32>(chosen[r, k, o, i])
    return cast<T>(y)
}

// `std.nn.moe::linear_experts_shared` with the experts' weights in MXFP4: a
// mixture's gate and up projections for many rows at once -- a prompt, a
// serving step -- `y[r, k, o] = sum_i x[r, i] * W[experts[r, k], o, i]`.
// The body dequantizes every expert and takes `linear_experts_shared`'s
// dense form, which a backend that prepares weight-only work does once at
// load; PyTorch on CUDA instead multiplies each expert by the rows that
// chose it, unpacking its four-bit blocks in registers.
pub op mxfp4_linear_experts_shared<R: Dim, K: Dim, E: Dim, Out: Dim, G: Dim, T: Float>(
    x: Tensor[R, G * 32; T],
    blocks: Tensor[E, Out, G, 32; f4e2m1],
    scales: Tensor[E, Out, G; u8],
    experts: Tensor[R, K; i64],
) -> Tensor[R, K, Out; T] {
    return linear_experts_shared(x, dequantize_mxfp4<E, Out, G, T>(blocks, scales), experts)
}

// `std.nn.moe::combine_experts` with the experts' weights in MXFP4: a
// mixture's down projection for many rows at once,
// `y[r, o] = sum_k weights[r, k] * sum_i x[r, k, i] * W[experts[r, k], o, i]`,
// as `mxfp4_linear_experts_shared` is to `linear_experts_shared`.
pub op mxfp4_combine_experts<R: Dim, K: Dim, E: Dim, Out: Dim, G: Dim, T: Float>(
    x: Tensor[R, K, G * 32; T],
    blocks: Tensor[E, Out, G, 32; f4e2m1],
    scales: Tensor[E, Out, G; u8],
    experts: Tensor[R, K; i64],
    weights: Tensor[R, K; T],
) -> Tensor[R, Out; T] {
    return combine_experts(x, dequantize_mxfp4<E, Out, G, T>(blocks, scales), experts, weights)
}
